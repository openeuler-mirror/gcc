load_lib gcc-dg.exp
load_lib torture-options.exp

# Initialize `dg'.
dg-init
torture-init

set ARRAY_LOAD_INLINE_TORTURE_OPTIONS [list \
	{ -O3 } ]

set-torture-options $ARRAY_LOAD_INLINE_TORTURE_OPTIONS {{}}

gcc-dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.c]] \
	"" "-fipa-array-load-inline -fdump-ipa-array-load-inline-details"

# All done.
torture-finish
dg-finish
