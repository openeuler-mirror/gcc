# GCC testsuite driver for openEuler-specific AArch64 feature tests.
#
# Everything this fork adds to the AArch64 testsuite lives under this
# directory.  Subdirectories mirror the upstream layout, and each one is
# driven below with the same options its upstream .exp uses, because the
# check-function-bodies and scan-assembler expectations were written
# against those options.
#
#   .                      gcc.target/aarch64/aarch64.exp
#   acle/                  gcc.target/aarch64/acle/acle.exp
#   simd/                  gcc.target/aarch64/simd/simd.exp
#   torture/               gcc.target/aarch64/torture/aarch64-torture.exp
#   advsimd-intrinsics/    gcc.target/aarch64/advsimd-intrinsics/...
#   sve/                   gcc.target/aarch64/sve/aarch64-sve.exp
#   sve/pcs/               gcc.target/aarch64/sve/pcs/aarch64-sve-pcs.exp
#   sve/acle/general-c/    gcc.target/aarch64/sve/acle/aarch64-sve-acle.exp
#   sve/acle/asm/          gcc.target/aarch64/sve/acle/aarch64-sve-acle-asm.exp
#   sve2/                  gcc.target/aarch64/sve2/aarch64-sve2.exp
#   sve2/acle/asm/         gcc.target/aarch64/sve2/acle/aarch64-sve2-acle-asm.exp
#
# Run only this suite with:
#   make check-gcc RUNTESTFLAGS="openeuler.exp"

# Exit immediately if this isn't an AArch64 target.
if ![istarget aarch64*-*-*] then {
  return
}

# Load support procs.
load_lib gcc-dg.exp
load_lib c-torture.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS " -ansi -pedantic-errors"
}

global dg-do-what-default
global C_TORTURE_OPTIONS
global LTO_TORTURE_OPTIONS

# Initialize `dg'.
dg-init

if { [check_effective_target_aarch64_sve] } {
    set oe_sve_flags ""
} else {
    set oe_sve_flags "-march=armv8.2-a+sve"
}

if { [check_effective_target_aarch64_sve2] } {
    set oe_sve2_flags ""
} else {
    set oe_sve2_flags "-march=armv8.5-a+sve2"
}

# -------------------------------------------------------------------------
# This directory, following gcc.target/aarch64/aarch64.exp.
# -------------------------------------------------------------------------

aarch64-with-arch-dg-options "" {
    dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cCS\]]] \
	"" $DEFAULT_CFLAGS
}

# -------------------------------------------------------------------------
# acle/, following gcc.target/aarch64/acle/acle.exp.
# -------------------------------------------------------------------------

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/acle/*.\[cCS\]]] \
    "" ""

# -------------------------------------------------------------------------
# simd/, following gcc.target/aarch64/simd/simd.exp.
# -------------------------------------------------------------------------

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/simd/*.\[cCS\]]] \
    "" $DEFAULT_CFLAGS

# -------------------------------------------------------------------------
# sve/, following gcc.target/aarch64/sve/aarch64-sve.exp.
# -------------------------------------------------------------------------

if { [check_effective_target_ilp32] } {
    set oe_sve_pattern "*_run"
} else {
    set oe_sve_pattern "*"
}

aarch64-with-arch-dg-options $oe_sve_flags {
    dg-runtest [lsort [glob -nocomplain \
			$srcdir/$subdir/sve/$oe_sve_pattern.\[cCS\]]] \
	"" $oe_sve_flags
}

# -------------------------------------------------------------------------
# sve/pcs/, following gcc.target/aarch64/sve/pcs/aarch64-sve-pcs.exp.
# -------------------------------------------------------------------------

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/sve/pcs/*.c]] \
    "$oe_sve_flags -fno-stack-protector" $DEFAULT_CFLAGS

# -------------------------------------------------------------------------
# sve/acle/general-c/, following
# gcc.target/aarch64/sve/acle/aarch64-sve-acle.exp.
# -------------------------------------------------------------------------

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/sve/acle/general-c/*.c]] \
    "$oe_sve_flags -moverride=tune=none" $DEFAULT_CFLAGS

# -------------------------------------------------------------------------
# sve2/, following gcc.target/aarch64/sve2/aarch64-sve2.exp.
# -------------------------------------------------------------------------

aarch64-with-arch-dg-options $oe_sve2_flags {
    dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/sve2/*.\[cCS\]]] \
	"" $oe_sve2_flags
}

# -------------------------------------------------------------------------
# torture/, following gcc.target/aarch64/torture/aarch64-torture.exp.
# -------------------------------------------------------------------------

gcc-dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/torture/*.\[cS\]]] \
    "" $DEFAULT_CFLAGS

# -------------------------------------------------------------------------
# advsimd-intrinsics/, following
# gcc.target/aarch64/advsimd-intrinsics/advsimd-intrinsics.exp.
# -------------------------------------------------------------------------

set oe_advsimd_files [lsort [glob -nocomplain \
			     $srcdir/$subdir/advsimd-intrinsics/*.c]]
if { [llength $oe_advsimd_files] != 0 } {
    set oe_saved_do_what ${dg-do-what-default}
    set dg-do-what-default run

    torture-init
    set-torture-options $C_TORTURE_OPTIONS {{}} $LTO_TORTURE_OPTIONS

    if { [check_effective_target_arm_v8_2a_fp16_neon_hw] } {
	set oe_advsimd_flags [add_options_for_arm_v8_2a_fp16_neon ""]
    } elseif { [check_effective_target_arm_neon_fp16_ok] } {
	set oe_advsimd_flags [add_options_for_arm_neon_fp16 ""]
    } else {
	set oe_advsimd_flags [add_options_for_arm_neon ""]
    }

    gcc-dg-runtest $oe_advsimd_files "" $oe_advsimd_flags

    torture-finish
    set dg-do-what-default $oe_saved_do_what
}

# -------------------------------------------------------------------------
# The two ACLE assembly suites.  Both use the torture harness with the
# option sets their upstream drivers set up, and both force the assembler
# only when it understands the extension in question.
# -------------------------------------------------------------------------

global gcc_runtest_parallelize_limit_minor
if { [info exists gcc_runtest_parallelize_limit_minor] } {
    set oe_old_limit_minor $gcc_runtest_parallelize_limit_minor
    set gcc_runtest_parallelize_limit_minor 1
}

# sve/acle/asm/, following
# gcc.target/aarch64/sve/acle/aarch64-sve-acle-asm.exp.
set oe_acle_files [lsort [glob -nocomplain $srcdir/$subdir/sve/acle/asm/*.c]]
if { [llength $oe_acle_files] != 0 } {
    # Turn off any codegen tweaks by default that may affect expected
    # assembly.  Tests relying on those should turn them on explicitly.
    set oe_asm_flags \
	"$oe_sve_flags -mtune=generic -moverride=tune=none -fno-ipa-icf"

    torture-init
    set-torture-options {
	"-std=c90 -O0 -g"
	"-std=c90 -O0 -DSTREAMING_COMPATIBLE"
	"-std=c90 -O1 -g"
	"-std=c99 -O2 -g"
	"-std=c11 -O3 -g"
	"-std=gnu90 -O2 -fno-schedule-insns -DCHECK_ASM --save-temps"
	"-std=gnu99 -Ofast -g"
	"-std=gnu11 -Os -g"
    } {
	"-DTEST_FULL"
	"-DTEST_OVERLOADS"
    }

    set oe_saved_do_what ${dg-do-what-default}
    if { [check_effective_target_aarch64_asm_sve_ok]
	 && [check_effective_target_aarch64_variant_pcs] } {
	set dg-do-what-default assemble
    } else {
	set dg-do-what-default compile
    }
    gcc-dg-runtest $oe_acle_files "" $oe_asm_flags
    set dg-do-what-default $oe_saved_do_what

    torture-finish
}

# sve2/acle/asm/, following
# gcc.target/aarch64/sve2/acle/aarch64-sve2-acle-asm.exp.
set oe_acle2_files [lsort [glob -nocomplain $srcdir/$subdir/sve2/acle/asm/*.c]]
if { [llength $oe_acle2_files] != 0 } {
    set oe_asm2_flags \
	"$oe_sve2_flags -mtune=generic -moverride=tune=none \
	 -moverride=tune=cheap_fpmr_write -fno-ipa-icf"

    torture-init
    set-torture-options {
	"-std=c90 -O0 -g"
	"-std=c90 -O0 -DSTREAMING_COMPATIBLE"
	"-std=c90 -O1 -g"
	"-std=c99 -O2 -g"
	"-std=c11 -O3 -g"
	"-std=gnu90 -O2 -fno-schedule-insns -DCHECK_ASM --save-temps"
	"-std=gnu99 -Ofast -g"
	"-std=gnu11 -Os -g"
    } {
	"-DTEST_FULL"
	"-DTEST_OVERLOADS"
    }

    set oe_saved_do_what ${dg-do-what-default}
    if { [check_effective_target_aarch64_asm_sve2_ok]
	 && [check_effective_target_aarch64_variant_pcs] } {
	set dg-do-what-default assemble
    } else {
	set dg-do-what-default compile
    }
    gcc-dg-runtest $oe_acle2_files "" $oe_asm2_flags
    set dg-do-what-default $oe_saved_do_what

    torture-finish
}

if { [info exists gcc_runtest_parallelize_limit_minor] } {
    set gcc_runtest_parallelize_limit_minor $oe_old_limit_minor
}

# All done.
dg-finish
